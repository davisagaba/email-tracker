# Server
PORT=3000
PUBLIC_URL=http://localhost:3000

# Track A — established mailbox (Gmail/Outlook app password). Low volume,
# no warm-up needed, used for high-priority/low-volume sends.
SMTP_A_HOST=smtp.gmail.com
SMTP_A_PORT=587
SMTP_A_USER=
SMTP_A_PASS=
SMTP_A_FROM=

# Track B — custom sending domain (e.g. via SendGrid). Primary bulk channel,
# subject to the warm-up curve unless DOMAIN_SENT_BEFORE=true.
SMTP_B_HOST=smtp.sendgrid.net
SMTP_B_PORT=587
SMTP_B_USER=apikey
SMTP_B_PASS=
SMTP_B_FROM=

# One-time onboarding answer: has this sending domain sent bulk email
# before? "true" skips warm-up and allows full volume from day one.
# "false" (default) runs the automated warm-up curve.
DOMAIN_SENT_BEFORE=false

# Delay in milliseconds between individual sends within a campaign
# (deliverability rate limiting — do not remove, see product-spec.md §14)
SEND_DELAY_MS=200

# Seed testing — comma-separated list of maintained test mailboxes across
# major providers, included on every send for inbox/spam diagnostics
# (placement checking itself is a Stage 5 IMAP mechanism; Phase 1 only
# logs these as pending/"unknown")
SEED_ADDRESSES=

# SendGrid inbound webhook (bounce/complaint events). If set, incoming
# webhook payloads are verified against this key; if left blank,
# verification is skipped (documented gap, untestable without real SendGrid).
SENDGRID_WEBHOOK_VERIFICATION_KEY=
